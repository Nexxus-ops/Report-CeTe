    +Guid PurchaseOrderId
    +Guid UserId
    +DateTimeOffset CreatedAt
  }
  class GoodsReceiptLine {
    +Guid GoodsReceiptId
    +Guid PurchaseOrderLineId
    +decimal Quantity
  }
