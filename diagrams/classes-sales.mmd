---
title: UML actual · Venta y comprobante · CeTe API
---
classDiagram
  class Sale {
    +Guid Id
    +Guid WarehouseId [private set]
    +Guid UserId [private set]
    +string CustomerName [private set]
    +string RequestHash [private set]
    +decimal TotalAmount [private set]
    +string Status [private set]
    +Confirm(IEnumerable~SaleLine~ lines) void
    +Cancel() void
  }
  class SaleLine {
    +Guid SaleId [private set]
    +Guid ProductId [private set]
    +string Sku [private set]
    +string Name [private set]
    +decimal Quantity [private set]
    +decimal UnitPrice [private set]
  }
  class Payment {
    +Guid SaleId [private set]
    +string Method [private set]
    +decimal Amount [private set]
    +string Status [private set]
    +Reverse() void
  }
  class SalesReceipt {
    +Guid SaleId [private set]
    +string Number [private set]
    +string CompanyName [private set]
    +string Ruc [private set]
    +string Address [private set]
    +string Cashier [private set]
    +DateTimeOffset IssuedAt [private set]
  }
  Sale "1" <-- "0..*" SaleLine : SaleId
  Sale "1" <-- "0..*" Payment : SaleId
  Sale "1" <-- "0..1" SalesReceipt : SaleId
