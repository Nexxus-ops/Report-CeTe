---
title: UML actual · Producto y saldo · CeTe API
---
classDiagram
  class Product {
    +Guid Id
    +Guid TenantId
    +string Sku [private set]
    +string Name [private set]
    +decimal UnitPrice [private set]
    +decimal MinimumStock [private set]
    +bool Active [private set]
    +UpdateDetails(Sku sku, string name, Money unitPrice, decimal minimumStock) void
    +Archive(bool hasStock) void
  }
  class StockBalance {
    +Guid ProductId
    +Guid WarehouseId
    +decimal Quantity [private set]
    +Receive(decimal amount) void
    +Remove(decimal amount) void
  }
  class InventoryMovement {
    +Guid ProductId
    +Guid WarehouseId
    +Guid UserId
    +decimal Quantity
    +string Reason
    +DateTimeOffset CreatedAt
  }
  class Sku {
    +string Value [get only]
    +Sku(string value)
  }
  class Money {
    +decimal Amount [get only]
    +Money(decimal amount)
  }
  Product ..> Sku : UpdateDetails
  Product ..> Money : UpdateDetails
  Product "1" <-- "0..*" StockBalance : ProductId
  Product "1" <-- "0..*" InventoryMovement : ProductId
